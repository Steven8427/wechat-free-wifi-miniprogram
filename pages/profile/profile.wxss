/* pages/profile/profile.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

/* ===== 顶部品牌区 ===== */
.header {
  background: linear-gradient(135deg, #07C160 0%, #06D66B 100%);
  padding: 56rpx 40rpx 64rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.brand-logo {
  width: 110rpx;
  height: 110rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
}

.brand-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.brand-slogan {
  font-size: 25rpx;
  color: rgba(255,255,255,0.85);
}

/* ===== 分组卡片 ===== */
.group {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.cell {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cell:last-child {
  border-bottom: none;
}

.cell-hover {
  background: #f7f7f7;
}

.cell-icon {
  font-size: 38rpx;
  width: 52rpx;
  flex-shrink: 0;
}

.cell-label {
  flex: 1;
  font-size: 29rpx;
  color: #1a1a1a;
}

.cell-value {
  font-size: 25rpx;
  color: #999;
  margin-right: 10rpx;
}

.cell-arrow {
  font-size: 40rpx;
  color: #ccc;
  line-height: 1;
}

/* button 重置（推荐给朋友） */
.cell-btn {
  width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding: 30rpx 28rpx;
  background: #fff;
  border-radius: 0;
  line-height: normal;
  text-align: left;
  font-weight: normal;
}

.cell-btn::after {
  border: none;
}

/* ===== 底部 ===== */
.footer {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 60rpx;
}

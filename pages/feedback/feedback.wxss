/* pages/feedback/feedback.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.tip-banner {
  padding: 28rpx 32rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #07C160;
}

/* ===== 卡片 ===== */
.card {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.optional {
  font-size: 24rpx;
  font-weight: normal;
  color: #999;
}

.ph {
  color: #bbb;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.contact-input {
  width: 100%;
  height: 56rpx;
  font-size: 28rpx;
  color: #333;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  margin: 40rpx 24rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.3);
}

.submit-btn[disabled] {
  background: #c8e6d3;
  color: #fff;
  box-shadow: none;
}
